# URL del proyecto de Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Clave pública anon (Project Settings → API). Es segura en el navegador.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Opcional: measurement ID de GA4 (G-...), no un contenedor GTM (GTM-...).
# Sin valor no se carga analítica.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
